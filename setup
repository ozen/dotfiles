#!/usr/bin/env bash

DOTFILES_ROOT=$HOME/.dotfiles

set -e

echo ''

info () {
    printf "  [ \033[00;34m..\033[0m ] $1"
}

user () {
    printf "\r  [ \033[0;33m?\033[0m ] $1 "
}

success () {
    printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
    printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
    echo ''
    exit
}

link_files () {
    ln -s $1 $2
    success "linked $1 to $2"
}

link_directory () {
    directory_source=$1
    directory_dest=$2

    if [ -L "$directory_dest" ] && [ "$directory_source" -ef "$directory_dest" ]
    then
        success "$directory_dest is already linked"
        return
    fi

    if [ -e "$directory_dest" ] || [ -L "$directory_dest" ]
    then
        user "Directory already exists: $directory_dest, what do you want to do? [s]kip, [o]verwrite, [b]ackup?"
        read -n 1 action
        echo ''

        case "$action" in
            o )
                if [ -d "$directory_dest" ] && ! [ -L "$directory_dest" ]
                then
                    rm -rf "$directory_dest"
                else
                    rm -f "$directory_dest"
                fi;;
            b )
                mv "$directory_dest" "$directory_dest.backup";;
            * )
                success "skipped $directory_dest"
                return;;
        esac
    fi

    link_files "$directory_source" "$directory_dest"
}

install_agent_skills () {
    skills_source="$DOTFILES_ROOT/agents/skills"

    if ! [ -d "$skills_source" ]
    then
        return
    fi

    info 'installing agent skills'
    mkdir -p "$HOME/.agents"
    link_directory "$skills_source" "$HOME/.agents/skills"
}

link_codex_file () {
    codex_source=$1
    codex_dest=$2

    if [ -L "$codex_dest" ] && [ "$codex_source" -ef "$codex_dest" ]
    then
        success "$codex_dest is already linked"
        return
    fi

    if [ -e "$codex_dest" ] || [ -L "$codex_dest" ]
    then
        if [ -f "$codex_dest" ] && cmp -s "$codex_source" "$codex_dest"
        then
            rm "$codex_dest"
        else
            user "File already exists: $codex_dest, what do you want to do? [s]kip, [o]verwrite, [b]ackup?"
            read -n 1 action
            echo ''

            case "$action" in
                o )
                    rm -f "$codex_dest";;
                b )
                    mv "$codex_dest" "$codex_dest.backup";;
                * )
                    success "skipped $codex_dest"
                    return;;
            esac
        fi
    fi

    link_files "$codex_source" "$codex_dest"
}

install_codex_config () {
    codex_config_source=$1
    codex_config_dest=$2

    if ! [ -f "$codex_config_source" ]
    then
        return
    fi

    if [ -L "$codex_config_dest" ] && [ "$codex_config_source" -ef "$codex_config_dest" ]
    then
        codex_config_tmp=`mktemp "$HOME/.codex/config.toml.XXXXXX"`
        cp "$codex_config_dest" "$codex_config_tmp"
        rm "$codex_config_dest"
        mv "$codex_config_tmp" "$codex_config_dest"
        chmod 600 "$codex_config_dest"
        success "converted $codex_config_dest to a local file"
        return
    fi

    if ! [ -e "$codex_config_dest" ] && ! [ -L "$codex_config_dest" ]
    then
        cp "$codex_config_source" "$codex_config_dest"
        chmod 600 "$codex_config_dest"
        success "copied $codex_config_source to $codex_config_dest"
        return
    fi

    if cmp -s "$codex_config_source" "$codex_config_dest"
    then
        success "left existing $codex_config_dest unchanged"
        return
    fi

    success "left existing $codex_config_dest unchanged; diff follows"
    if diff -u "$codex_config_source" "$codex_config_dest"
    then
        :
    fi
}

install_codex_files () {
    codex_root="$DOTFILES_ROOT/codex"

    if ! [ -d "$codex_root" ]
    then
        return
    fi

    info 'installing Codex files'
    mkdir -p "$HOME/.codex/pets"

    if [ -f "$codex_root/AGENTS.md" ]
    then
        link_codex_file "$codex_root/AGENTS.md" "$HOME/.codex/AGENTS.md"
    fi

    install_codex_config "$codex_root/config.toml" "$HOME/.codex/config.toml"

    for pet_source in "$codex_root"/pets/*
    do
        if ! [ -d "$pet_source" ]
        then
            continue
        fi

        pet_name=`basename "$pet_source"`
        pet_dest="$HOME/.codex/pets/$pet_name"
        mkdir -p "$pet_dest"

        for pet_file in pet.json spritesheet.webp
        do
            if [ -f "$pet_source/$pet_file" ]
            then
                link_codex_file "$pet_source/$pet_file" "$pet_dest/$pet_file"
            fi
        done
    done
}

setup_gitconfig () {
    if ! [ -f gitconfig.symlink ]
    then
        info 'setup gitconfig'

        user ' - What is your github author email?'
        read -e git_authoremail

        sed -e "s/AUTHOREMAIL/$git_authoremail/g" gitconfig.symlink.example > gitconfig.symlink

        success 'gitconfig'
    fi
}

install_dotfiles () {
    info 'installing dotfiles'

    overwrite_all=false
    backup_all=false
    skip_all=false

    for source in `find $DOTFILES_ROOT -maxdepth 2 -name \*.symlink`
    do
        dest="$HOME/.`basename \"${source%.*}\"`"

        if [ -f $dest ] || [ -d $dest ]
        then

            overwrite=false
            backup=false
            skip=false

            if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
            then
                user "File already exists: `basename $source`, what do you want to do? [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
                read -n 1 action

                case "$action" in
                    o )
                        overwrite=true;;
                    O )
                        overwrite_all=true;;
                    b )
                        backup=true;;
                    B )
                        backup_all=true;;
                    s )
                        skip=true;;
                    S )
                        skip_all=true;;
                    * )
                        ;;
                esac
            fi

            if [ "$overwrite" == "true" ] || [ "$overwrite_all" == "true" ]
            then
                rm -rf $dest
                success "removed $dest"
            fi

            if [ "$backup" == "true" ] || [ "$backup_all" == "true" ]
            then
                mv $dest $dest\.backup
                success "moved $dest to $dest.backup"
            fi

            if [ "$skip" == "false" ] && [ "$skip_all" == "false" ]
            then
                link_files $source $dest
            else
                success "skipped $source"
            fi

        else
            link_files $source $dest
        fi
    done
}

install_submodules () {
    cd $DOTFILES_ROOT
    git submodule update --init
}

install_submodules
setup_gitconfig
install_dotfiles
install_agent_skills
install_codex_files

echo ''
echo '  All installed!'
